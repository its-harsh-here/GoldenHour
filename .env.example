# GoldenHour configuration. Copy to .env and edit. Never commit .env.
# groq | mock | replay   (mock needs no network; replay serves recorded runs)
LLM_MODE=mock
PORT=8000
HOST=127.0.0.1

# Groq (only needed for LLM_MODE=groq). Get a key at console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_FAST=openai/gpt-oss-20b
MODEL_REASON=openai/gpt-oss-120b
MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m
# Local throttle per model (free tier is roughly 30 RPM / 8K TPM)
GROQ_RPM=30
GROQ_TPM=8000
LLM_TIMEOUT_S=30

# Record groq responses into packs/health_preauth/data/replay_cache.json (redacted content only)
REPLAY_RECORD=false
# Pre-process the non-hero inbox cases so the dashboard has history
SEED_HISTORY=true
DB_PATH=data/goldenhour.db
