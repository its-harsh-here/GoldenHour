# GoldenHour configuration. Copy to .env and edit. Never commit .env.
# live | mock | replay   (mock needs no network; replay serves recorded runs)
LLM_MODE=mock
PORT=8000
HOST=127.0.0.1

# Live mode: any OpenAI-compatible chat-completions endpoint. Without these, live falls back to replay.
LLM_BASE_URL=
LLM_API_KEY=
# Provider model ids for the three roles: extraction/tool calls/drafting, explanations, injection screening
MODEL_FAST=
MODEL_REASON=
MODEL_GUARD=
# Local throttle per role (match your provider's rate limits)
LLM_RPM=30
LLM_TPM=8000
LLM_TIMEOUT_S=30
# Sent with agent calls to reasoning models; leave empty if your models do not support reasoning_effort
LLM_REASONING_EFFORT=low

# Record live responses into packs/health_preauth/data/replay_cache.json (redacted content only)
REPLAY_RECORD=false
# Pre-process the non-hero inbox cases so the dashboard has history
SEED_HISTORY=true
DB_PATH=data/goldenhour.db

# Live feed: synthetic hospital requests keep arriving at random (Poisson) intervals, processed on arrival
LIVE_FEED=true
FEED_INTERVAL_S=40
# mock (default, never spends LLM quota) or inherit (use LLM_MODE above for feed cases)
FEED_LLM=mock
FEED_SIMULATE_DESK=true
FEED_MAX_CASES=40

# Day replay: the last 24 hours of requests on a simulated clock (mock pipeline)
DAY_VOLUME=200
DAY_BACKFILL=true
DAY_REPLAY_MINUTES=3
