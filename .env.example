# GoldenHour configuration. Copy to .env and edit. Never commit .env.
# live | mock | replay   (mock needs no network; replay serves recorded runs)
LLM_MODE=mock
PORT=8000
HOST=127.0.0.1

# Live mode: any OpenAI-compatible chat-completions endpoint. Without these, live falls back to replay.
LLM_BASE_URL=
LLM_API_KEY=
# Provider model ids for the three roles: extraction/tool calls/drafting, explanations, injection screening
MODEL_FAST=
MODEL_REASON=
MODEL_GUARD=
# Local throttle per role (match your provider's rate limits)
LLM_RPM=30
LLM_TPM=8000
LLM_TIMEOUT_S=30
# Sent with agent calls to reasoning models; leave empty if your models do not support reasoning_effort
LLM_REASONING_EFFORT=low

# Record live responses into packs/health_preauth/data/replay_cache.json (redacted content only)
REPLAY_RECORD=false
# Pre-process the non-hero inbox cases so the dashboard has history
SEED_HISTORY=true
DB_PATH=data/goldenhour.db

# Live feed: synthetic hospital requests keep arriving at random (Poisson) intervals and land as New
LIVE_FEED=true
FEED_INTERVAL_S=40
# Each arrival lands as New and the agents pick it up within seconds. In live mode, up to this many arrivals an
# hour run on the live model; the rest run on the simulator (mock answers with model-like timing). 0 = none.
FEED_LIVE_PER_HOUR=6
# Scales the simulator's model-like timing (1 = realistic, 0 = instant)
SIM_PACE=1
FEED_SIMULATE_DESK=true
FEED_MAX_CASES=40

# Day replay: the last 24 hours of requests on a simulated clock (simulator, model-like timing)
DAY_VOLUME=200
DAY_BACKFILL=true
DAY_REPLAY_MINUTES=3
